# log verbosity shortcut: 1 means DEBUG, 0 means INFO
VERBOSE=0

# explicit log level, overrides VERBOSE when set: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=

# log file path; empty means %LOCALAPPDATA%\iets-speed-control\logs\iets-speed-control.log
LOG_FILE=

# device name for esp32 (Optional)
DEVICE_NAME="USB-Enhanced-SERIAL CH9102"

# device serial for esp32 (Optional)
DEVICE_SERIAL="568B022419"

# default COM port for esp32
DEFAULT_PORT=COM7

# serial port baudrate
SERIAL_BAUDRATE=115200

# timeout in seconds for serial commands
SERIAL_TIMEOUT=0.1

# serial command to get/set PWM
PWM_COMMAND=Dimmer

# delay in seconds between checks
DELAY=0.1

# maximum step at a time while LOWERING the PWM. Raising it is deliberately unlimited:
# the fan should spin up immediately when the chip gets hot, and coast down gradually
MAX_STEP=2

# minimal dimmer value change to ignore
IGNORE_LESS_THAN=3

# how many readings the rolling median covers, to absorb one-off temperature spikes. 1 disables smoothing
TEMP_WINDOW=5

# re-read the PWM value from the device every N ticks, to notice changes made outside this app
# (e.g. via the Tasmota web UI). 0 never re-reads after the initial connection
RESYNC_EVERY=30

# temperature source: aida64 | lhm (LibreHardwareMonitor via WMI) | lhm-web (its web server)
SENSOR_PROVIDER=aida64

# lhm-web only: address of the LibreHardwareMonitor remote web server, and its request timeout
LHM_WEB_URL=http://localhost:8085/data.json
LHM_WEB_TIMEOUT=1.0

# lhm-web only: credentials, if Remote Web Server -> Authentication is enabled. Leave empty when it is not
LHM_WEB_USERNAME=
LHM_WEB_PASSWORD=

# text filter for CPU Sensor Name
CPU_SENSOR_FILTER=CPU

# text filter for GPU Sensor Name
GPU_SENSOR_FILTER=GPU

# Temperature ranges and their corresponding PWM ranges
# E.g. (0, 50, 0, 0) If the temperature is between 0 and 50 degrees, take the corresponding PWM value from 0 to 0
# E.g. (80, 90, 65, 75) If the temperature is between 80 and 90 degrees, take the corresponding PWM value from 65 to 75
TEMP_RANGES="(55, 64, 20, 49), (65, 68, 50, 50), (69, 79, 51, 64), (80, 89, 65, 74), (90, 100, 75, 100)"
